<div class="flex min-h-full flex-col items-stretch justify-between lg:flex-row">
  <div class="flex w-full flex-col bg-white lg:flex-row lg:border-r">
    <main class="relative z-0 mb-10 flex-1 focus:outline-none xl:order-last">
      <article class="sticky top-0">
        <!-- Header -->
        <div class="hidden lg:block">
          <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
            <div class="my-6 flex min-w-0 select-none flex-row gap-x-2">
              <%= if @is_authenticated? do %>
                <h1 class="truncate text-2xl font-bold text-zinc-900">
                  Welcome, <%= @current_user.name %>
                </h1>
              <% else %>
                <h1 class="truncate text-2xl font-bold text-zinc-900">
                  Welcome to Atomic
                </h1>
              <% end %>
              <span class="animate-wave text-2xl">
                👋
              </span>
            </div>
          </div>
        </div>
        <!-- Tabs -->
        <div x-data="{ option: 'all' }" class="sticky top-10 z-10 block bg-white lg:top-0">
          <.tabs class="mx-auto max-w-5xl px-4 pt-1 sm:px-6 lg:px-8">
            <.tab id="tab-all" active={@current_tab == "all"} phx-click="load-all" phx-hook="ScrollToTop">
              <%= gettext("All") %>
            </.tab>
            <.tab id="tab-following" active={@current_tab == "following"} phx-click="load-following" phx-hook="ScrollToTop">
              <%= gettext("Following") %>
            </.tab>
            <%= if length(@schedule_default.weekly) + length(@schedule_default.daily) > 0 do %>
              <.tab id="tab-schedule" active={@current_tab == "schedule"} phx-click="load-schedule" phx-hook="ScrollToTop" class="lg:hidden">
                <%= gettext("Schedule") %>
              </.tab>
            <% end %>
          </.tabs>
        </div>
        <!-- Feed -->
        <%= if @current_tab != "schedule" do %>
          <%= if @is_authenticated? == false && @current_tab == "following" do %>
            <div class="mt-6">
              <.unauthenticated_state />
            </div>
          <% else %>
            <ul id="feed" role="list" phx-update="stream" phx-viewport-bottom="load-more">
              <li :for={{id, post} <- @streams.posts} id={id} class="mx-auto max-w-5xl border-b border-zinc-200 px-4 py-4 sm:px-6 lg:px-8">
                <%= if post.type == :activity do %>
                  <.link navigate={~p"/activities/#{post.activity}"}>
                    <.activity activity={post.activity} />
                  </.link>
                <% else %>
                  <.link navigate={~p"/organizations/#{post.announcement.organization.id}/announcements/#{post.announcement}"}>
                    <.announcement announcement={post.announcement} />
                  </.link>
                <% end %>
              </li>
            </ul>
          <% end %>
        <% else %>
          <.schedule schedule={@schedule_default} current_user={@current_user} />
        <% end %>
      </article>
    </main>
  </div>
  <div id="scroll-panel" phx-hook="StickyScroll" class="sticky top-0 hidden h-fit w-full border-t border-zinc-200 pb-6 sm:pr-6 lg:block lg:w-72 lg:flex-shrink-0 lg:border-t-0 lg:pb-0 xl:pr-0">
    <!-- Organizations to follow -->
    <section aria-labelledby="organizations-to-follow" class="border-b border-zinc-200 pt-6 pr-4 pl-6">
      <.follow_suggestions current_user={@current_user} organizations={@organizations} />
    </section>
    <!-- Schedule -->
    <section aria-labelledby="schedule" class="pr-4 pl-6">
      <div class="flex items-center justify-between pt-4">
        <h1 class="text-zinc-90 text-xl font-bold">Schedule</h1>
        <.dropdown
          :if={@current_user}
          id="schedule-dropdown"
          orientation={:down}
          items={[
            %{
              name: gettext("All"),
              phx_click: "show-schedule-default"
            },
            %{
              name: gettext("My schedule"),
              phx_click: "show-schedule-user"
            }
          ]}
        >
          <:wrapper>
            <.button color={:white} size={:xs} class="flex items-center space-x-1">
              <span>
                <%= if @schedule == :user do %>
                  <%= gettext("My schedule") %>
                <% else %>
                  <%= gettext("All") %>
                <% end %>
              </span>
              <.icon name="hero-chevron-down" class="size-4" />
            </.button>
          </:wrapper>
        </.dropdown>
      </div>
      <%= if @schedule == :user do %>
        <.schedule schedule={@schedule_user} current_user={@current_user} tab="user" />
      <% else %>
        <.schedule schedule={@schedule_default} current_user={@current_user} tab="all" />
      <% end %>
    </section>
    <!-- Legal Pages Links -->
    <.legal_pages_links />
  </div>
</div>
