<div class="mt-16">
  <.form id="activity-form" for={@form} phx-change="validate" phx-submit="save" phx-target={@myself}>
    <div class="flex flex-col justify-evenly gap-8 xl:flex-row">
      <div class="flex w-full xl:w-1/3">
        <%= if @activity.card do %>
          <div class="flex rounded-xl">
            <.image_uploader id="activity-image" class="h-full items-center justify-center rounded-xl" upload={@uploads.card} icon="hero-photo" memory_unit="MB" image_class="h-full w-full rounded-xl object-cover" image={Uploaders.Post.url({@activity.card, @activity}, :original)} />
          </div>
        <% else %>
          <div class="border-primary-500 flex h-full w-full justify-center rounded-xl border-4 border-dashed">
            <.image_uploader id="activity-image" class="h-full w-full" upload={@uploads.card} icon="hero-photo" memory_unit="MB" image_class="h-full w-full object-cover" />
          </div>
        <% end %>
      </div>

      <div class="flex flex-col">
        <div class="flex flex-col">
          <div class="w-full">
            <.field type="text" field={@form[:title]} label_class="hidden" wrapper_class="!bg-white text-3xl" autocomplete="off" class="border-none focus:ring-0 shadow-none font-bold text-4xl !bg-white p-0" placeholder="Activity Title" required />
          </div>
        </div>
        <div class="flex w-full">
          <div class="justify-top hidden flex-col items-center pt-3 sm:flex">
            <div class="size-3 bg-primary-600 m-1 rounded-full" />
            <div class="flex justify-center">
              <div class="border-l-primary-600 h-[3.25rem] w-[3px] border-l border-dashed" />
            </div>
            <div class="size-3 border-primary-600 m-1 rounded-full border" />
          </div>
          <div class="flex w-full flex-col">
            <div class="text-nowrap flex flex-col items-baseline justify-between gap-y-1 sm:flex-row sm:p-1 sm:pl-3">
              <span>Start</span>
              <div class="w-full sm:w-56">
                <.field class="w-full text-gray-900 sm:w-56" type="datetime-local" field={@form[:start]} label_class="hidden" error_label_class="hidden" required />
              </div>
            </div>
            <div class="text-nowrap flex flex-col items-baseline justify-between gap-y-1 sm:flex-row sm:p-1 sm:pl-3">
              <span>End</span>
              <div class="w-full sm:w-56">
                <.field class="w-full text-gray-900 sm:w-56" type="datetime-local" field={@form[:finish]} label_class="hidden" error_label_class="hidden" required />
              </div>
            </div>
          </div>
        </div>

        <label for="description_button" class="atomic-label atomic-label--required">
          Description
        </label>
        <.button
          id="description_button"
          class="group atomic-button atomic-button--primary-outline py-[10px] flex flex-col items-start rounded-md border-gray-300 bg-white px-3 text-gray-300 focus-within:bg-white hover:bg-white sm:py-[8px] lg:w-full"
          type="button"
          phx-click="toggle_description_modal"
          phx-target={@myself}
        >
          <%= if not @has_description? do %>
            <label class="py-[2px] cursor-pointer text-left font-normal text-gray-500">
              Add description
            </label>
          <% end %>
          <div class="w-full">
            <.field
              :if={@has_description?}
              type="text"
              field={@form[:description]}
              label=""
              readonly
              label_class="hidden"
              wrapper_class="m-0"
              autocomplete="off"
              class="atomic-button pointer-events-none cursor-pointer select-none border-none bg-transparent p-0 text-sm text-gray-900 shadow-none focus:border-transparent focus:outline-none focus:ring-0"
            />
          </div>
        </.button>

        <div class="flex flex-col justify-center md:flex-row md:justify-start xl:justify-between">
          <.inputs_for :let={fl} field={@form[:location]}>
            <div class="mt-3 flex flex-col gap-y-1 sm:mt-4">
              <.field class="text-gray-900" type="text" field={fl[:name]} label="Location" placeholder="Choose location name" required />
            </div>
            <div class="-mt-2 flex flex-col gap-y-1 sm:-mt-2 md:mt-4 md:ml-8">
              <.field class="text-gray-900" type="text" field={fl[:address]} label="Address" placeholder="Address" required />
            </div>
          </.inputs_for>
        </div>

        <label for="capacity_button" class="atomic-label atomic-label--required -mt-2">
          Capacity
        </label>
        <.button
          id="capacity_button"
          type="button"
          class="group atomic-button atomic-button--primary-outline py-[10px] flex flex-col items-start rounded-md border-gray-300 bg-white px-3 text-gray-300 focus-within:bg-white hover:bg-white sm:py-2 lg:w-full"
          phx-click="toggle_maximum_entries_modal"
          phx-target={@myself}
        >
            <.field
              class="cursor-pointer border-none bg-transparent p-0 text-sm text-gray-900 shadow-none focus:border-transparent focus:outline-none focus:ring-0 caret-transparent"
              type="number"
              field={@form[:maximum_entries]}
              label="Maximum entries"
              placeholder={if @has_max_capacity?, do: "Choose maximum capacity", else: "∞ Unlimited"}
              value={if @has_max_capacity?, do: @form[:maximum_entries].value, else: ""}
              readonly
              required
              label_class="hidden"
              wrapper_class="m-0"
              error_class="text-danger-600 placeholder-danger-700"
              error_label_class="text-danger-700"
            />
        </.button>

        <div class="mt-4 flex-grow">
          <div class="flex justify-center lg:justify-end">
            <.button class="w-full p-4 lg:p-3" type="submit" phx-disable-with="Saving...">
              <%= if @action == :new do %>
                <span>{gettext("Create Activity")}</span>
              <% else %>
                <span>{gettext("Save")}</span>
              <% end %>
            </.button>
          </div>
        </div>
      </div>
    </div>
    <.modal :if={@description_modal} id="description-modal" show on_cancel={JS.push("toggle_description_modal", target: @myself)} class="textarea">
      <div class="mt-4 flex-grow">
        <.field id="input" class="\-h-10 resize-none" type="textarea" field={@form[:description]} label="Description" placeholder="Choose description" rows={15} required phx-hook="FocusEnd" />
        <div class="flex w-full justify-end">
          <.button class="text" type="button" phx-click="toggle_description_modal" phx-target={@myself}>
            <span>{gettext("Done")}</span>
          </.button>
        </div>
      </div>
    </.modal>
    <.modal :if={@maximum_entries_modal} class="inset-0" id="maximum_entries_modal" show on_cancel={JS.push("toggle_maximum_entries_modal", target: @myself)}>
      <div class="h-full w-full">
        <div class="">
          <%= if @has_max_capacity? do %>
            <.field id="input" type="number" field={@form[:maximum_entries]} placeholder="Choose maximum entries" phx-hook="FocusEnd" />
          <% else %>
            <.field id="input" type="number" field={@form[:maximum_entries]} value="" placeholder="∞ Unlimited" phx-hook="FocusEnd" />
          <% end %>
        </div>
        <div class="flex gap-3">
          <.button type="button" phx-click="toggle_maximum_entries_modal" phx-target={@myself}>
            {gettext("Close")}
          </.button>
          <.button type="button" phx-click="remove_max_capacity" phx-target={@myself}>
            {gettext("Remove limit")}
          </.button>
        </div>
      </div>
    </.modal>
  </.form>
</div>
