<div class="mt-16">
  <.form id="activity-form" for={@form} phx-change="validate" phx-submit="save" phx-target={@myself}>
    <div class="flex flex-col justify-evenly gap-8 xl:flex-row">
      <div class="w-full xl:w-1/3">
        <.live_component module={ImageUploader} id="uploader" uploads={@uploads} target={@myself} image={Uploaders.Post.url({@activity.image, @activity}, :original)} />
      </div>

      <div class="flex flex-col">
        <div class="flex flex-col">
          <div class="w-full">
            <.field
              type="text"
              field={@form[:title]}
              label_class="hidden"
              wrapper_class="!bg-white text-3xl"
              autocomplete="off"
              error_class="text-danger-600 placeholder-danger-700"
              error_label_class="text-danger-700"
              class="border-none focus:ring-0 shadow-none font-bold text-4xl !bg-white p-0"
              placeholder="Activity Title"
              required
            />
          </div>
        </div>
        <div class="flex w-full">
          <div class="justify-top flex hidden flex-col items-center pt-3 sm:block">
            <div class="size-3 bg-primary-600 m-1 rounded-full" />
            <div class="flex justify-center">
              <div class="border-l-primary-600 h-[3.25rem] w-[3px] border-l border-dashed" />
            </div>
            <div class="size-3 border-primary-600 m-1 rounded-full border" />
          </div>
          <div class="flex w-full flex-col">
            <div class="text-nowrap flex flex-col items-baseline justify-between gap-y-1 sm:flex-row sm:p-1 sm:pl-3">
              <span>Start</span>
              <div class="w-full sm:w-56">
                <.field class="atomic-button atomic-button--primary-outline w-full text-gray-900 sm:w-56" type="datetime-local" field={@form[:start]} label_class="hidden" error_label_class="hidden" required />
              </div>
            </div>
            <div class="text-nowrap flex flex-col items-baseline justify-between gap-y-1 sm:flex-row sm:p-1 sm:pl-3">
              <span>End</span>
              <div class="w-full sm:w-56">
                <.field class="atomic-button atomic-button--primary-outline w-full text-gray-900 sm:w-56" type="datetime-local" field={@form[:finish]} label_class="hidden" error_label_class="hidden" required />
              </div>
            </div>
          </div>
        </div>

        <label for="description_button" class="atomic-label atomic-label--required">
          Description
        </label>
        <.button id="description_button" class="group atomic-button atomic-button--primary-outline flex flex-col items-start rounded-md border-gray-300 bg-white px-3 py-[10px] sm:py-2 text-gray-300 focus-within:bg-white lg:w-full" type="button" phx-click="toggle_description_modal" phx-target={@myself}>
          <%= if not @has_description? do %>
            <label class="cursor-pointer text-left text-gray-500">
              Add description
            </label>
          <% end %>
          <div class="w-full">
            <.field
              :if={@has_description?}
              type="text"
              field={@form[:description]}
              label=""
              readonly
              label_class="hidden"
              wrapper_class="m-0"
              autocomplete="off"
              error_class="text-danger-600 placeholder-danger-700"
              error_label_class="text-danger-700"
              class="cursor-pointer border-none bg-transparent p-0 text-sm text-gray-900 shadow-none focus:border-transparent focus:outline-none focus:ring-0"
            />
          </div>
        </.button>

        <div class="flex flex-col justify-center md:flex-row md:justify-start xl:justify-between">
          <.inputs_for :let={fl} field={@form[:location]}>
            <div class="mt-3 sm:mt-4 flex flex-col gap-y-1">
              <.field class="atomic-button atomic-button--primary-outline text-gray-900" type="text" field={fl[:name]} label="Location" placeholder="Choose location name" required />
            </div>
            <div class="-mt-2 sm:-mt-2 md:mt-4 flex flex-col gap-y-1 md:ml-8">
              <.field class="atomic-button atomic-button--primary-outline text-gray-900" type="text" field={fl[:address]} label="Address" placeholder="Address" required />
            </div>
          </.inputs_for>
        </div>

        <label for="capacity_button" class="atomic-label atomic-label--required -mt-2">
          Capacity
        </label>
        <.button id="capacity_button" type="button" class="group atomic-button atomic-button--primary-outline flex flex-col items-start rounded-md border-gray-300 bg-white px-3 py-[10px] sm:py-2 text-gray-300 focus-within:bg-white lg:w-full" phx-click="toggle_maximum_entries_modal" phx-target={@myself}>
          <%= if @has_max_capacity? do %>
            <.field
              class="cursor-pointer border-none bg-transparent p-0 text-sm text-gray-900 shadow-none focus:border-transparent focus:outline-none focus:ring-0 atomic-text-input"
              type="number"
              field={@form[:maximum_entries]}
              label="Maximum entries"
              placeholder="Choose maximum capacity"
              readonly
              required
              label_class="hidden"
              wrapper_class="m-0"
              error_class="text-danger-600 placeholder-danger-700"
              error_label_class="text-danger-700"
            />
          <% else %>
            <.field
              class="cursor-pointer border-none bg-transparent p-0 text-sm text-gray-900 shadow-none focus:border-transparent focus:outline-none focus:ring-0"
              type="number"
              field={@form[:maximum_entries]}
              label="Maximum entries"
              placeholder="∞ Unlimited"
              value=" "
              readonly
              required
              label_class="hidden"
              wrapper_class="m-0"
              error_class="text-danger-600 placeholder-danger-700"
              error_label_class="text-danger-700"
            />
          <% end %>
        </.button>

        <div class="mt-4 flex-grow">
          <div class="flex justify-center lg:justify-end">
            <.button class="w-full p-4 lg:p-3" type="submit" phx-disable-with="Saving...">
              <%= if @action == :new do %>
                <span><%= gettext("Create Activity") %></span>
              <% else %>
                <span><%= gettext("Save") %></span>
              <% end %>
            </.button>
          </div>
        </div>
      </div>
    </div>
    <.modal :if={@description_modal} id="description-modal" show on_cancel={JS.push("toggle_description_modal", target: @myself)}>
      <div class="mt-4 flex-grow">
        <.field class="\-h-10 resize-none " type="textarea" field={@form[:description]} label="Description" placeholder="Choose description" rows={15} required />
        <div class="flex w-full justify-end">
          <.button class="text" type="button" phx-click="toggle_description_modal" phx-target={@myself}>
            <span><%= gettext("Done") %></span>
          </.button>
        </div>
      </div>
    </.modal>
    <.modal :if={@maximum_entries_modal} id="maximum_entries_modal" show on_cancel={JS.push("toggle_maximum_entries_modal", target: @myself)}>
      <div class="h-full w-full">
        <div class="">
          <%= if @has_max_capacity? do %>
            <.field class="" type="number" field={@form[:maximum_entries]} placeholder="Choose maximum entries" />
          <% else %>
            <.field class="" type="number" field={@form[:maximum_entries]} value="" placeholder="∞ Unlimited" />
          <% end %>
        </div>
        <div class="flex gap-3">
          <.button type="button" phx-click="toggle_maximum_entries_modal" phx-target={@myself}>
            Close
          </.button>
          <.button type="button" phx-target={@myself} phx-click="remove_max_capacity">
            Remove limit
          </.button>
        </div>
      </div>
    </.modal>
  </.form>
</div>
