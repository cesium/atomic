<.page title={@activity.title}>
  <:title_wrapper :let={title}>
    <div class="grid">
      <h1 class="select-none pb-2  text-2xl font-bold text-gray-900">
        <%= title %>
      </h1>
      <span class="flex items-center gap-2">
        <p>
          <%= gettext("hosted by") %>
        </p>
        <.link navigate={~p"/organizations/#{@activity.organization.id}"} class="flex items-center gap-1">
          <.avatar class={@activity.organization.logo && "border-0"} src={Uploaders.Logo.url({@activity.organization.logo, @activity.organization}, :original)} name={@activity.organization.name} size={:xs} type={:organization} color={:white} />
          <%= @activity.organization.name %>
        </.link>
      </span>
    </div>
  </:title_wrapper>
  <:actions>
    <%= if @current_view == "show" do %>
      <!-- Actions (desktop) -->
      <div class="sm:flex hidden gap-4">
        <%= if @is_authenticated? do %>
          <.button :if={not @max_enrolled? and !@enrolled?} color={:white} icon="hero-ticket" patch={~p"/activities/#{@activity.id}/enroll"} disabled={@enrolled?}>
            <%= gettext("Register") %>
          </.button>
          <.button :if={@enrolled?} patch={~p"/activities/#{@activity.id}/ticket"} color={:white} icon="hero-ticket">
            <%= gettext("Ticket") %>
          </.button>
          <.button :if={@has_permissions?} navigate={~p"/organizations/#{@activity.organization_id}/activities/#{@activity.id}/edit"} icon="hero-pencil">
            <%= gettext("Edit activity") %>
          </.button>
        <% end %>
      </div>
      <!-- Actions (mobile) -->
      <div class="sm:hidden block">
        <.dropdown id="activity-actions-dropdown" items={generate_dropdown_items(@enrolled?, @has_permissions?, @activity, @socket)}>
          <:wrapper>
            <.button icon_variant={:solid} color={:white} icon="hero-ellipsis_horizontal" />
          </:wrapper>
        </.dropdown>
      </div>
    <% end %>
    <%= if @current_view == "attendees" do %>
      <.button icon="hero-arrow-left-solid" color={:white} patch={~p"/activities/#{@activity.id}"} />
    <% end %>
  </:actions>
  <!-- Activity image (mobile) -->
  <%= if @current_view == "show" do %>
    <div class="sm:hidden pb-8 px-8 sm:px-6 flex w-full justify-center">
      <div class="w-full aspect-square object-cover">
        <%= if @activity.image do %>
          <img class="h-full w-full object-cover rounded-xl border" src={Uploaders.Post.url({@activity.image, @activity}, :original)} />
        <% else %>
          <.gradient class="rounded-xl" seed={@activity.id} />
        <% end %>
      </div>
    </div>
    <div class="grid grid-cols-5 gap-12 mx-4 max-w-5xl sm:mx-6 lg:mx-8">
      <div class="sm:col-span-3 col-span-5 flex flex-col gap-6">
        <div class="flex flex-row gap-16 justify-between sm:justify-normal">
          <!-- Date -->
          <%= if @activity.start do %>
            <div class="flex items-center gap-2">
              <.icon name="hero-calendar" solid class="h-5 w-5 text-gray-700" />
              <!-- One day activity -->
              <%= if Timex.to_date(@activity.start) == Timex.to_date(@activity.finish) do %>
                <div class="flex flex-col">
                  <p class="font-medium">
                    <%= pretty_display_date(@activity.start) %>
                  </p>
                  <p>
                    <%= "#{display_time(@activity.start)}-#{display_time(@activity.finish)}" %>
                  </p>
                </div>
              <% end %>
              <!-- TODO: Support for multi-day activities -->
            </div>
          <% end %>
          <!-- Capacity -->
          <.link phx-click="handle_attendees_modal">
            <div class="flex items-center gap-2">
              <.icon name="hero-user-group" class="h-5 w-5 text-gray-700" />
              <p class="font-medium">
                <%= @activity.enrolled %> / <%= @activity.maximum_entries %>
              </p>
            </div>
          </.link>
        </div>
        <!-- Enrollment (desktop) -->
        <%= if @enrolled? do %>
          <div class="sm:block hidden">
            <div class="flex flex-row items-center gap-2">
              <.icon name="hero-check-badge" class="h-5 w-5 text-gray-700" />
              <div>
                <h2 class="flex-1 select-none truncate text-md font-semibold text-gray-900">
                  <%= gettext("You are going!") %>
                </h2>
                <p>
                  <%= gettext("If you can't go please unenroll") %>
                  <.link patch={~p"/activities/#{@activity.id}/unenroll/"}>
                    <span class="text-primary-500 underline"><%= gettext("here") %></span>.
                  </.link>
                </p>
              </div>
            </div>
          </div>
        <% end %>
        <!-- About -->
        <div>
          <h2 class="mb-2 flex-1 select-none truncate text-lg font-semibold text-gray-900">
            <%= gettext("About") %>
          </h2>
          <div class="flex flex-col gap-2">
            <%= text_to_html(@activity.description) %>
          </div>
        </div>
        <!-- Location -->
        <div :if={@activity.location}>
          <h2 class="mb-2 flex-1 select-none truncate text-lg font-semibold text-gray-900">
            <%= gettext("Location") %>
          </h2>
          <div class="pb-4">
            <p>
              <%= @activity.location.name %>
            </p>
            <p class="text-sm text-gray-600">
              <%= @activity.location.address %>
            </p>
          </div>
          <figure class="border rounded-xl">
            <.map location={@activity.location.address} class="rounded-xl" />
          </figure>
        </div>
        <!-- Action buttons (mobile) -->
        <div class="sm:hidden block pt-8">
          <!-- Register button -->
          <.button :if={not @max_enrolled? and !@enrolled?} icon="hero-ticket" size={:lg} patch={~p"/activities/#{@activity.id}/enroll/"} full_width>
            <%= gettext("Register") %>
          </.button>
          <!-- Ticket and unenroll buttons -->
          <div :if={@enrolled?} class="grid grid-cols-3 gap-2">
            <.button class="col-span-2" patch={~p"/activities/#{@activity.id}/ticket/"} icon="hero-ticket" size={:lg} full_width>
              <%= gettext("View ticket") %>
            </.button>
            <.button patch={~p"/activities/#{@activity.id}/unenroll/"} color={:white} icon="hero-user-minus" size={:lg} full_width></.button>
          </div>
        </div>
      </div>
      <div class="sm:block hidden col-span-2 w-full object-cover">
        <!-- Activity image (desktop) -->
        <%= if @activity.image do %>
          <img class="max-h-fit w-full object-cover rounded-xl border" src={Uploaders.Post.url({@activity.image, @activity}, :original)} />
        <% else %>
          <.gradient class="!h-[50vh] rounded-xl border" seed={@activity.id} />
        <% end %>
        <div class="flex flex-col">
          <!-- Activity participants (desktop) -->
          <div :if={@activity.enrolled > 0} class="pt-4">
            <h2 class="mb-2 flex-1 select-none truncate text-md font-semibold text-gray-900">
              <%= gettext("%{enrolled} Going", enrolled: @activity.enrolled) %>
            </h2>
            <.avatar_group
              size={:xs}
              items={
                @participants
                |> Enum.take(6)
                |> Enum.map(fn p -> %{name: p.name} end)
                |> then(fn avatars ->
                  if length(@participants) > 6 do
                    Enum.concat(avatars, [%{name: "+#{length(@participants) - 6}", auto_generate_initials: false}])
                  else
                    avatars
                  end
                end)
              }
            />
          </div>
          <%= if length(@participants) == 0 do %>
            <span class="text-orange-500 flex justify-center pt-2"><%= gettext("No participants on this activity") %></span>
          <% else %>
            <%= if @has_permissions? do %>
              <.link patch={~p"/activities/#{@activity.id}?tab=attendees"} class="text-orange-500 hover:cursor-pointer hover:underline">
                <%= gettext("View all") %>
              </.link>
            <% else %>
              <.link phx-click="handle_attendees_modal" class="text-orange-500 hover:cursor-pointer hover:underline">
                <%= gettext("View all") %>
              </.link>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <%= if @current_view == "attendees" do %>
    <%= if length(@participants) != 0 do %>
      <%= if @has_permissions? do %>
        <div class="mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="mb-4 flex-1 select-none truncate text-lg font-semibold text-zinc-900">Participants</h2>
          <div class="border-t border-l">
            <.table items={@participants} meta={@meta} filter={[]}>
              <:col :let={participant} label="Name"><%= participant.name %></:col>
              <:col :let={participant} label="Email"><%= participant.email %></:col>
              <:col :let={participant} label="Phone number"><%= participant.phone_number %></:col>
            </.table>
          </div>
          <.pagination items={@participants} meta={@meta} params={@params} class="flex w-full items-center justify-between border border-t-0 pt-2" />
        </div>
      <% else %>
        <ul>
          <%= for participant <- @participants do %>
            <li><%= participant.name %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  <% end %>
</.page>
<!-- Ticket show modal -->
<.modal :if={@live_action in [:ticket] and @enrolled?} modal_class="p-0" id="ticket-modal" show on_cancel={JS.patch(~p"/activities/#{@activity.id}")}>
  <div class="w-full flex flex-col gap-2 justify-center text-center">
    <p class="text-md font-semibold text-gray-900">
      <%= gettext("Show this code to the staff present at the activity to register your presence.") %>
    </p>
    <%= draw_ticket_qr_code(@enrollment_id) |> raw %>
  </div>
</.modal>
<!-- Enrollment modal -->
<.modal :if={@live_action in [:enroll, :unenroll]} id="action-confirm-modal" show on_cancel={JS.patch(~p"/activities/#{@activity.id}")}>
  <div class="flex flex-col">
    <h1 class="flex-1 select-none text-lg font-semibold text-gray-900">
      <%= display_action_goal_confirm_title(@live_action) %>
    </h1>
    <p class="mt-4">
      <%= display_action_goal_confirm_description(@live_action) %>
    </p>
    <div class="mt-8 flex flex-row">
      <.button patch={~p"/activities/#{@activity.id}/"} class="mr-2" size={:lg} icon="hero-x-circle" color={:white} full_width><%= gettext("Cancel") %></.button>
      <.button
        phx-click="confirm"
        class="ml-2"
        size={:lg}
        icon="hero-check-circle"
        color={
          if @live_action == :unenroll do
            :danger
          else
            :success
          end
        }
        full_width
      >
        <%= gettext("Confirm") %>
      </.button>
    </div>
  </div>
</.modal>
<!-- Attendees show modal -->
<.modal :if={@attendees_modal} show id="attendees_modal" on_cancel={JS.push("handle_attendees_modal")}>
  <span class="flex-l text-lg font-semibold text-gray-900">Participants</span>
  <%= if length(@participants) != 0 do %> 
    <div class="">
      <ul>
        <%= for participant <- @participants do %>
          <li class="h-6 p-6 border-b flex items-center justify-center"><%= participant.name %></li>
        <% end %>
      </ul>
    </div>
  <% else %>
  <div class="mt-4">
    <span>There are no participants for this activity</span>
  </div>
  <% end %>
</.modal>
