<div class="bg-hero-pattern flex h-screen w-screen flex-col items-center justify-center bg-opacity-25 bg-cover bg-center bg-no-repeat lg:bg-[length:2000px_1400px]">
  <.form :let={f} for={@changeset} action={~p"/users/reset_password/#{@token}"} class="mx-8 mt-8 flex h-full w-full flex-col items-center justify-center space-y-6 sm:mx-0">
    <h2 class="mx-4 mt-6 select-none text-center text-5xl font-bold text-zinc-900">
      <span><%= gettext("Reset Password") %></span>
    </h2>
    <%= if @error_message do %>
      <div class="w-full sm:px-0 px-4 sm:w-96 mx-4 mt-4 ">
        <div class="flex flex-row w-full alert alert-danger text-sm bg-red-100 border-l-4 border-primary-400 text-red-700 px-4 py-4">
          <.icon name="hero-exclamation_circle-solid" class="w-5 h-5 mr-2 text-red-400" />
          <div>
            <p><%= @error_message %></p>
          </div>
        </div>
      </div>
    <% end %>

    <div class="space-y-3 rounded-md w-full flex-col mt-6">
      <div class="flex flex-col items-center justify-center mx-4">
        <div x-data="{ hide: true }" class="sm:w-96 flex flex-row items-center justify-center w-full border border-zinc-300 rounded placeholder-zinc-500 focus-within:z-10 focus-within:border-primary-400 focus-within:ring-primary-400 focus-within:ring-1 sm:text-sm">
          <%= label(f, :password, "New password", class: "sr-only") %>
          <%= password_input(f, :password, required: true, placeholder: gettext("New password"), class: "relative w-full appearance-none rounded border-0 text-zinc-900 outline-none focus:ring-0 sm:text-sm") %>
          <div x-show="hide" x-on:click="hide = false; document.getElementById('user_password').type = 'text';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
          <div x-show="!hide" x-on:click="hide = true; document.getElementById('user_password').type = 'password';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-slash-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
        </div>
        <span class="mx-4 w-full text-sm text-red-600 sm:w-96"><%= error_tag(f, :password) %></span>
      </div>

      <div class="flex flex-col items-center justify-center mx-4">
        <div x-data="{ hide_confirm: true }" class="sm:w-96 flex flex-row items-center justify-center w-full border border-zinc-300 rounded placeholder-zinc-500 focus-within:z-10 focus-within:border-primary-400 focus-within:ring-primary-400 focus-within:ring-1 sm:text-sm">
          <%= label(f, :password_confirmation, "Confirm new password", class: "sr-only") %>
          <%= password_input(f, :password_confirmation,
            required: true,
            placeholder: gettext("Confirm new password"),
            class: "relative w-full appearance-none rounded border-0 text-zinc-900 outline-none focus:ring-0 sm:text-sm"
          ) %>
          <div x-show="hide_confirm" x-on:click="hide_confirm = false; document.getElementById('user_password_confirmation').type = 'text';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
          <div x-show="!hide_confirm" x-on:click="hide_confirm = true; document.getElementById('user_password_confirmation').type = 'password';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-slash-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
        </div>
        <span class="mx-4 w-full text-sm text-red-600 sm:w-96"><%= error_tag(f, :password_confirmation) %></span>
      </div>
    </div>

    <div class="w-full flex-col">
      <div class="mx-4 justify-center flex select-none">
        <%= submit class: "w-full flex justify-center border-2 rounded-md bg-primary-500 text-lg border-primary-500 py-2 px-3.5 text-sm font-medium text-white shadow-sm sm:w-96" do %>
          <%= gettext("Change Password") %>
        <% end %>
      </div>
    </div>
  </.form>
</div>
