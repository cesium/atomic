<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={csrf_token_value()} />
    <.live_title>
      {assigns[:page_title] || "Atomic"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body class="bg-hero-pattern flex h-full w-full flex-row items-center justify-center overflow-x-hidden bg-white bg-cover bg-center bg-no-repeat lg:bg-75">
    <main class="grid min-h-full place-items-center px-6 py-24 sm:py-32 lg:px-8">
      <div class="text-center">
        <p class="text-primary-500 text-base font-semibold">500</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-900 sm:text-5xl">Internal Server Error</h1>
        <p class="mt-6 text-base leading-7 text-zinc-600">Oops! It appears that something went wrong on our end.</p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a href="/" class="bg-primary-500 rounded-md px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-600 focus-visible:outline-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">Go back home</a>
        </div>
      </div>
    </main>
  </body>
</html>
