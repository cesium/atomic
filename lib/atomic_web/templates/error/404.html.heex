<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={csrf_token_value()} />
    <%= live_title_tag(assigns[:page_title] || "Atomic", suffix: " · 404") %>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <div class="bg-hero-pattern flex h-screen w-screen flex-col items-center justify-center bg-white bg-opacity-25 bg-cover bg-center bg-no-repeat lg:bg-[length:2000px_1400px]">
    <div class="flex flex-col items-center">
      <div class="flex flex-row items-center gap-4">
        <span class="text-5xl font-bold uppercase text-zinc-900">Error</span>
        <span class="pb-2 text-6xl font-bold text-zinc-900">404</span>
      </div>
      <h2 class="text-lg font-semibold text-zinc-900">Page Not Found</h2>
      <.link href="/" class="inline-flex items-center rounded-md bg-primary-500 px-3 py-2 my-4 text-sm font-semibold text-white shadow-sm hover:bg-primary-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
        <%= gettext("Go back home") %>
      </.link>
    </div>
  </div>
</html>
