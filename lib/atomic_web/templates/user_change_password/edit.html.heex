<div class="bg-hero-pattern flex h-screen w-screen flex-col items-center justify-center bg-opacity-25 bg-cover bg-center bg-no-repeat lg:bg-[length:2000px_1400px]">
  <.form :let={f} for={@changeset} action={~p"/users/change_password"} id="update_password" class="mx-8 mt-8 flex h-full w-full flex-col items-center justify-center space-y-6 sm:mx-0">
    <h2 class="mx-4 mt-6 select-none text-center text-5xl font-bold text-zinc-900">
      <span>{gettext("Change Password")}</span>
    </h2>
    <%= if @error_message do %>
      <div class="mx-4 mt-4 w-full px-4 sm:w-96 sm:px-0">
        <div class="alert alert-danger border-primary-400 flex w-full flex-row border-l-4 bg-red-100 px-4 py-4 text-sm text-red-700">
          <.icon name="hero-exclamation-circle-solid" class="mr-2 h-5 w-5 text-red-400" />
          <div>
            <p>{@error_message}</p>
          </div>
        </div>
      </div>
    <% end %>

    {hidden_input(f, :action, value: "update_password")}

    <div class="mt-6 w-full flex-col space-y-3 rounded-md">
      <div class="mx-4 flex flex-col items-center justify-center">
        <div x-data="{ hide: true }" class="flex w-full flex-row items-center justify-center rounded border border-zinc-300 placeholder-zinc-500 focus-within:border-primary-400 focus-within:ring-primary-400 focus-within:z-10 focus-within:ring-1 sm:w-96 sm:text-sm">
          {label(f, :current_password, "Current password", class: "sr-only")}
          {password_input(f, :current_password, required: true, placeholder: gettext("Current password"), class: "relative w-full appearance-none rounded border-0 text-zinc-900 outline-none focus:ring-0 sm:text-sm")}
          <div x-show="hide" x-on:click="hide = false; document.getElementById('update_password_current_password').type = 'text';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
          <div x-show="!hide" x-on:click="hide = true; document.getElementById('update_password_current_password').type = 'password';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-slash-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
        </div>
        <span class="mx-4 w-full text-sm text-red-600 sm:w-96">{error_tag(f, :current_password)}</span>
      </div>

      <div class="mx-4 flex flex-col items-center justify-center">
        <div x-data="{ hide: true }" class="flex w-full flex-row items-center justify-center rounded border border-zinc-300 placeholder-zinc-500 focus-within:border-primary-400 focus-within:ring-primary-400 focus-within:z-10 focus-within:ring-1 sm:w-96 sm:text-sm">
          {label(f, :password, "New password", class: "sr-only")}
          {password_input(f, :password, required: true, placeholder: gettext("New password"), class: "relative w-full appearance-none rounded border-0 text-zinc-900 outline-none focus:ring-0 sm:text-sm")}
          <div x-show="hide" x-on:click="hide = false; document.getElementById('update_password_password').type = 'text';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
          <div x-show="!hide" x-on:click="hide = true; document.getElementById('update_password_password').type = 'password';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-slash-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
        </div>
        <span class="mx-4 w-full text-sm text-red-600 sm:w-96">{error_tag(f, :password)}</span>
      </div>

      <div class="mx-4 flex flex-col items-center justify-center">
        <div x-data="{ hide_confirm: true }" class="flex w-full flex-row items-center justify-center rounded border border-zinc-300 placeholder-zinc-500 focus-within:border-primary-400 focus-within:ring-primary-400 focus-within:z-10 focus-within:ring-1 sm:w-96 sm:text-sm">
          {label(f, :password_confirmation, "Confirm new password", class: "sr-only")}
          {password_input(f, :password_confirmation,
            required: true,
            placeholder: gettext("Confirm new password"),
            class: "relative w-full appearance-none rounded border-0 text-zinc-900 outline-none focus:ring-0 sm:text-sm"
          )}
          <div x-show="hide_confirm" x-on:click="hide_confirm = false; document.getElementById('update_password_password_confirmation').type = 'text';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
          <div x-show="!hide_confirm" x-on:click="hide_confirm = true; document.getElementById('update_password_password_confirmation').type = 'password';" class="w-fit cursor-pointer px-2">
            <.icon name="hero-eye-slash-solid" class="h-auto w-5 fill-black hover:fill-black" />
          </div>
        </div>
        <span class="mx-4 w-full text-sm text-red-600 sm:w-96">{error_tag(f, :password_confirmation)}</span>
      </div>
    </div>

    <div class="w-full flex-col">
      <div class="mx-4 flex select-none justify-center">
        {submit("Change Password", class: "border-primary-500 bg-primary-500 flex w-full justify-center rounded-md border-2 px-3.5 py-2 text-sm text-lg font-medium text-white shadow-sm sm:w-96")}
      </div>
    </div>
  </.form>
</div>
